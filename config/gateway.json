{
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "worker_threads": 0,
    "max_connections": 10000,
    "jwt_secret": "change-in-production",
    "tls_enabled": false,
    "tls_cert_file": "/etc/throttlr/tls.crt",
    "tls_key_file":  "/etc/throttlr/tls.key"
  },
  "rate_limit": {
    "enabled": true,
    "requests": 100,
    "window_seconds": 60,
    "key_type": "ip"
  },
  "cors": {
    "enabled": true,
    "origins": ["*"]
  },
  "circuit_breaker": {
    "failure_threshold": 5,
    "open_timeout_ms": 30000,
    "success_threshold": 2
  },
  "backends": [
    {"name": "backend1", "host": "127.0.0.1", "port": 9001, "weight": 1},
    {"name": "backend2", "host": "127.0.0.1", "port": 9002, "weight": 1},
    {"name": "backend3", "host": "127.0.0.1", "port": 9003, "weight": 1}
  ],
  "routes": [
    {"name": "protected", "path": "/api/protected.*", "backend": "default", "auth_required": true},
    {"name": "public",    "path": "/.*",               "backend": "default", "auth_required": false}
  ]
}
